# 🌍 Production Environment Configuration

# 🐍 Backend Configuration
PYTHON_ENV=production
DEBUG=false
LOG_LEVEL=WARNING

# 🗄️ Database Configuration
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/anga_production
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# 🔴 Redis Configuration
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=${REDIS_PASSWORD}
REDIS_DB=0

# 🔑 API Keys
GROQ_API_KEY=${GROQ_API_KEY}
OPENWEATHER_API_KEY=${OPENWEATHER_API_KEY}

# 🚀 Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=8

# 🔒 Security Configuration
SECRET_KEY=${SECRET_KEY}
JWT_SECRET_KEY=${JWT_SECRET_KEY}
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15

# 📊 Monitoring Configuration
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
GRAFANA_ENABLED=true
GRAFANA_PORT=3000

# 📝 Logging Configuration
LOG_FORMAT=json
LOG_FILE=/app/logs/production.log
LOG_ROTATION=daily
LOG_RETENTION_DAYS=90

# 🔍 Health Check Configuration
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=15
HEALTH_CHECK_TIMEOUT=5

# 📱 Mobile App Configuration
MOBILE_API_BASE_URL=https://api.anga.com
MOBILE_APP_VERSION=1.0.0

# 🌐 CORS Configuration
CORS_ORIGINS=["https://anga.com", "https://mobile.anga.com"]
CORS_METHODS=["GET", "POST", "PUT", "DELETE", "OPTIONS"]
CORS_HEADERS=["*"]

# 📊 Performance Configuration
CACHE_TTL=600
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW=60

# 🔒 Security Headers
SECURITY_HEADERS_ENABLED=true
HSTS_ENABLED=true
CSP_ENABLED=true

# 📈 Analytics Configuration
ANALYTICS_ENABLED=true
ANALYTICS_PROVIDER=mixpanel
ANALYTICS_TOKEN=${MIXPANEL_TOKEN}

# 🔔 Notification Configuration
NOTIFICATION_ENABLED=true
NOTIFICATION_PROVIDER=firebase
FIREBASE_SERVER_KEY=${FIREBASE_SERVER_KEY}

# 📊 Error Tracking
ERROR_TRACKING_ENABLED=true
ERROR_TRACKING_PROVIDER=sentry
SENTRY_DSN=${SENTRY_DSN}

# 🌍 Feature Flags
FEATURE_AI_ASSISTANT=true
FEATURE_WEATHER_FORECAST=true
FEATURE_FARMING_ADVICE=true
FEATURE_NOTIFICATIONS=true
FEATURE_ANALYTICS=true

# 🔒 SSL Configuration
SSL_ENABLED=true
SSL_CERT_PATH=/app/ssl/cert.pem
SSL_KEY_PATH=/app/ssl/key.pem

# 📊 Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=${BACKUP_S3_BUCKET}

# 🔍 Audit Logging
AUDIT_LOGGING_ENABLED=true
AUDIT_LOG_LEVEL=INFO
AUDIT_LOG_RETENTION_DAYS=365
