# 🔐 Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env files to version control

# =============================================================================
# 🐍 BACKEND CONFIGURATION
# =============================================================================

# Environment
PYTHON_ENV=development
DEBUG=true
LOG_LEVEL=DEBUG

# =============================================================================
# 🗄️ DATABASE CONFIGURATION
# =============================================================================

# Database URL (PostgreSQL)
DATABASE_URL=postgresql://username:password@localhost:5432/anga_dev

# Database Pool Settings
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# =============================================================================
# 🔴 REDIS CONFIGURATION
# =============================================================================

# Redis URL
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# =============================================================================
# 🔑 API KEYS
# =============================================================================

# Groq API Key (for AI assistant)
GROQ_API_KEY=your_groq_api_key_here

# OpenWeather API Key (for weather data)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# =============================================================================
# 🚀 SERVER CONFIGURATION
# =============================================================================

# Server Settings
HOST=0.0.0.0
PORT=8000
WORKERS=1

# =============================================================================
# 🔒 SECURITY CONFIGURATION
# =============================================================================

# Secret Keys (generate strong random keys)
SECRET_KEY=your-secret-key-here
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# =============================================================================
# 📊 MONITORING CONFIGURATION
# =============================================================================

# Prometheus
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_ENABLED=true
GRAFANA_PORT=3000

# =============================================================================
# 📝 LOGGING CONFIGURATION
# =============================================================================

# Log Settings
LOG_FORMAT=json
LOG_FILE=logs/app.log
LOG_ROTATION=daily
LOG_RETENTION_DAYS=7

# =============================================================================
# 🔍 HEALTH CHECK CONFIGURATION
# =============================================================================

# Health Check Settings
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=60
HEALTH_CHECK_TIMEOUT=30

# =============================================================================
# 📱 MOBILE APP CONFIGURATION
# =============================================================================

# Mobile API
MOBILE_API_BASE_URL=http://localhost:8000
MOBILE_APP_VERSION=1.0.0-dev

# =============================================================================
# 🌐 CORS CONFIGURATION
# =============================================================================

# CORS Settings
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]
CORS_METHODS=["GET", "POST", "PUT", "DELETE", "OPTIONS"]
CORS_HEADERS=["*"]

# =============================================================================
# 📊 PERFORMANCE CONFIGURATION
# =============================================================================

# Cache Settings
CACHE_TTL=300
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# =============================================================================
# 🔒 SECURITY HEADERS
# =============================================================================

# Security Headers
SECURITY_HEADERS_ENABLED=true
HSTS_ENABLED=false
CSP_ENABLED=false

# =============================================================================
# 📈 ANALYTICS CONFIGURATION
# =============================================================================

# Analytics
ANALYTICS_ENABLED=false
ANALYTICS_PROVIDER=mixpanel
ANALYTICS_TOKEN=your_mixpanel_token_here

# =============================================================================
# 🔔 NOTIFICATION CONFIGURATION
# =============================================================================

# Notifications
NOTIFICATION_ENABLED=false
NOTIFICATION_PROVIDER=firebase
FIREBASE_SERVER_KEY=your_firebase_server_key_here

# =============================================================================
# 📊 ERROR TRACKING
# =============================================================================

# Error Tracking
ERROR_TRACKING_ENABLED=false
ERROR_TRACKING_PROVIDER=sentry
SENTRY_DSN=your_sentry_dsn_here

# =============================================================================
# 🌍 FEATURE FLAGS
# =============================================================================

# Feature Flags
FEATURE_AI_ASSISTANT=true
FEATURE_WEATHER_FORECAST=true
FEATURE_FARMING_ADVICE=true
FEATURE_NOTIFICATIONS=false
FEATURE_ANALYTICS=false

# =============================================================================
# 🔒 SSL CONFIGURATION (Production Only)
# =============================================================================

# SSL Settings (uncomment for production)
# SSL_ENABLED=true
# SSL_CERT_PATH=/app/ssl/cert.pem
# SSL_KEY_PATH=/app/ssl/key.pem

# =============================================================================
# 📊 BACKUP CONFIGURATION (Production Only)
# =============================================================================

# Backup Settings (uncomment for production)
# BACKUP_ENABLED=true
# BACKUP_SCHEDULE="0 2 * * *"
# BACKUP_RETENTION_DAYS=30
# BACKUP_S3_BUCKET=your_backup_bucket_here

# =============================================================================
# 🔍 AUDIT LOGGING (Production Only)
# =============================================================================

# Audit Logging (uncomment for production)
# AUDIT_LOGGING_ENABLED=true
# AUDIT_LOG_LEVEL=INFO
# AUDIT_LOG_RETENTION_DAYS=365
