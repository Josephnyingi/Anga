# Simple nginx-based web service for Flutter web app
FROM nginx:alpine

# Install curl for health checks
RUN apk add --no-cache curl

# Copy built Flutter web app
COPY apps/web/build/web /usr/share/nginx/html

# Copy optimized index.html with HTML renderer
COPY apps/web/web/index_optimized.html /usr/share/nginx/html/index.html

# Copy test file
COPY apps/web/web/test.html /usr/share/nginx/html/test.html

# Copy nginx configuration
COPY apps/web/nginx.conf /etc/nginx/nginx.conf

# Expose port 80
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost/ || exit 1

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
