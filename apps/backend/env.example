# ANGA Backend Environment Configuration

# Application
APP_NAME=ANGA Weather App
APP_VERSION=1.0.0
DEBUG=false

# Security
SECRET_KEY=your-secret-key-here

# Database
DATABASE_URL=sqlite:///./weather.db
DATABASE_TEST_URL=sqlite:///./test_weather.db

# External APIs
OPEN_METEO_API_URL=https://api.open-meteo.com/v1
GROQ_API_KEY=your-groq-api-key-here
GROQ_API_URL=https://api.groq.com/openai/v1

# NVIDIA Earth-2 via Hugging Face Inference API
# Get a free token at: https://huggingface.co/settings/tokens
# Models: nvidia/fourcastnet | nvidia/corrdiff | nvidia/sfno
# Docs:   https://huggingface.co/collections/nvidia/earth-2-open-models
HF_TOKEN=your-huggingface-token-here

# Redis (optional)
REDIS_URL=redis://localhost:6379

# CORS
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# USSD Service (optional)
USSD_SERVICE_URL=http://localhost:8001
